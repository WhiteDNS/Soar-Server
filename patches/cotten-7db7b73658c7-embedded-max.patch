diff --git a/internal/udpserver/embedded_max_test.go b/internal/udpserver/embedded_max_test.go
new file mode 100644
index 0000000..06e7521
--- /dev/null
+++ b/internal/udpserver/embedded_max_test.go
@@ -0,0 +1,79 @@
+package udpserver
+
+import (
+	"context"
+	"errors"
+	"net"
+	"testing"
+	"time"
+
+	"cottendns-go/internal/cottenmax"
+)
+
+func TestEmbeddedMaxSharesNormalSessionBudgetAndCloses(t *testing.T) {
+	in := embeddedSessionLimitConfig(1)
+	e, err := NewEmbedded(context.Background(), in)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer e.Close()
+	legacy, _, err := e.s.sessions.findOrCreate(legacyInitPayload(1), 0, 0, 8, false)
+	if err != nil || legacy == nil {
+		t.Fatal("normal session", err)
+	}
+	pc, err := net.ListenPacket("udp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer pc.Close()
+	go func() {
+		buf := make([]byte, 4096)
+		for {
+			n, addr, err := pc.ReadFrom(buf)
+			if err != nil {
+				return
+			}
+			if reply := e.HandleDNS(buf[:n]); len(reply) > 0 {
+				pc.WriteTo(reply, addr)
+			}
+		}
+	}()
+	makeClient := func() *cottenmax.Client {
+		c, err := cottenmax.NewClient(cottenmax.ClientConfig{Domain: in.Domain, Secret: in.Key, Resolvers: []string{pc.LocalAddr().String()}})
+		if err != nil {
+			t.Fatal(err)
+		}
+		return c
+	}
+	blocked := makeClient()
+	ctx, cancel := context.WithTimeout(context.Background(), 300*time.Millisecond)
+	err = blocked.Authenticate(ctx)
+	cancel()
+	blocked.Close()
+	if err == nil {
+		t.Fatal("Max bypassed normal session reservation")
+	}
+	e.s.sessions.Close(legacy.ID, time.Now(), 0)
+	client := makeClient()
+	defer client.Close()
+	ctx, cancel = context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	if err = client.Probe(ctx, 1024); err != nil {
+		t.Fatal("Max after normal release", err)
+	}
+	if e.SessionCount() != 1 {
+		t.Fatal("Max missing from account diagnostics", e.SessionCount())
+	}
+	if _, _, err = e.s.sessions.findOrCreate(legacyInitPayload(2), 0, 0, 8, false); !errors.Is(err, ErrSessionTableFull) {
+		t.Fatal("normal bypassed Max reservation", err)
+	}
+	if err = e.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if e.SessionCount() != 0 {
+		t.Fatal("Max session reservation leaked", e.SessionCount())
+	}
+	if reply := e.HandleDNS([]byte{1}); len(reply) != 0 {
+		t.Fatal("closed account answered")
+	}
+}
