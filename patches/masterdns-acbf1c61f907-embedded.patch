new file mode 100644
index 0000000..9f0292c
--- /dev/null
+++ b/internal/udpserver/embedded_test.go
@@ -0,0 +1,98 @@
+package udpserver
+
+import (
+	"context"
+	"errors"
+	"net"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func embeddedPolicyConfig(allowed *atomic.Bool) EmbeddedConfig {
+	return EmbeddedConfig{Domain: "md.account.example.com", Key: "test-only-MasterDNS-key-material-00001", Allowed: allowed.Load,
+		DialContext: func(context.Context, string, string) (net.Conn, error) {
+			return nil, errors.New("account policy denied")
+		},
+		ExchangeDNS: func(context.Context, []byte) ([]byte, error) { return nil, errors.New("account policy denied") }}
+}
+
+func TestEmbeddedRequiresPolicyAndNativeSessionBounds(t *testing.T) {
+	var allowed atomic.Bool
+	allowed.Store(true)
+	cfg := embeddedPolicyConfig(&allowed)
+	for _, limit := range []int{-1, 256} {
+		cfg.MaxActiveSessions = limit
+		if e, err := NewEmbedded(context.Background(), cfg); err == nil {
+			e.Close()
+			t.Fatal("invalid session limit accepted", limit)
+		}
+	}
+	cfg.MaxActiveSessions = 255
+	e, err := NewEmbedded(context.Background(), cfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer e.Close()
+	if e.s.cfg.MaxAllowedClientActiveSessions != 255 {
+		t.Fatal("native session limit lost")
+	}
+	cfg.DialContext = nil
+	if e, err := NewEmbedded(context.Background(), cfg); err == nil {
+		e.Close()
+		t.Fatal("unmetered fallback allowed")
+	}
+}
+
+func TestEmbeddedPolicyAndShutdown(t *testing.T) {
+	var allowed atomic.Bool
+	allowed.Store(true)
+	cfg := embeddedPolicyConfig(&allowed)
+	entered := make(chan struct{}, 1)
+	cfg.DialContext = func(ctx context.Context, _, _ string) (net.Conn, error) {
+		entered <- struct{}{}
+		<-ctx.Done()
+		return nil, ctx.Err()
+	}
+	e, err := NewEmbedded(context.Background(), cfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer e.Close()
+	query := buildTestDNSQuery(42, "probe.md.account.example.com", 1)
+	if len(e.HandleDNS(query)) == 0 {
+		t.Fatal("active account did not answer")
+	}
+	allowed.Store(false)
+	if len(e.HandleDNS(query)) != 0 {
+		t.Fatal("disabled account answered")
+	}
+	if _, err := e.s.resolveDNSUpstream(query); !errors.Is(err, net.ErrClosed) {
+		t.Fatal("disabled account bypassed DNS policy", err)
+	}
+	if _, err := e.s.dialTCPTargetContext(context.Background(), "8.8.8.8:443"); !errors.Is(err, net.ErrClosed) {
+		t.Fatal("disabled account bypassed TCP policy", err)
+	}
+	allowed.Store(true)
+	done := make(chan error, 1)
+	go func() { _, err := e.s.dialTCPTargetContext(context.Background(), "8.8.8.8:443"); done <- err }()
+	select {
+	case <-entered:
+	case <-time.After(time.Second):
+		t.Fatal("dial hook not called")
+	}
+	if err := e.Close(); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case err := <-done:
+		if !errors.Is(err, context.Canceled) {
+			t.Fatal("dial was not cancelled", err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("dial leaked after close")
+	}
+	if len(e.HandleDNS(query)) != 0 {
+		t.Fatal("closed engine answered")
+	}
+}
