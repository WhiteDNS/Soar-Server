diff --git a/internal/udpserver/embedded.go b/internal/udpserver/embedded.go
new file mode 100644
index 0000000..956e031
--- /dev/null
+++ b/internal/udpserver/embedded.go
@@ -0,0 +1,145 @@
+// WhiteDNS embedding adapter. The MasterDnsVPN wire protocol is unchanged.
+package udpserver
+
+import (
+	"context"
+	"errors"
+	"net"
+	"strings"
+	"sync"
+	"time"
+
+	"masterdnsvpn-go/internal/config"
+	"masterdnsvpn-go/internal/logger"
+	"masterdnsvpn-go/internal/security"
+)
+
+// EmbeddedConfig describes one account behind a caller-owned DNS listener.
+// Every egress operation requires caller policy; no direct-dial fallback exists.
+type EmbeddedConfig struct {
+	Domain               string
+	Domains              []string
+	Key                  string
+	MaxActiveSessions    int
+	MaxStreamsPerSession int
+	DialContext          func(context.Context, string, string) (net.Conn, error)
+	ExchangeDNS          func(context.Context, []byte) ([]byte, error)
+	Allowed              func() bool
+}
+
+type Embedded struct {
+	s       *Server
+	ctx     context.Context
+	cancel  context.CancelFunc
+	allowed func() bool
+	mu      sync.RWMutex
+	once    sync.Once
+	wg      sync.WaitGroup
+}
+
+func NewEmbedded(parent context.Context, in EmbeddedConfig) (*Embedded, error) {
+	if parent == nil || in.Domain == "" || len(in.Key) < 32 || in.Allowed == nil || in.DialContext == nil || in.ExchangeDNS == nil {
+		return nil, errors.New("embedded MasterDNS requires domain, key and all account-policy hooks")
+	}
+	if in.MaxActiveSessions < 0 || in.MaxActiveSessions > 255 || in.MaxStreamsPerSession < 0 || in.MaxStreamsPerSession > 65535 {
+		return nil, errors.New("invalid MasterDNS session or stream limit")
+	}
+	domains := in.Domains
+	if len(domains) == 0 {
+		domains = []string{in.Domain}
+	}
+	if len(domains) > 8 {
+		return nil, errors.New("at most eight MasterDNS domains")
+	}
+	for _, domain := range domains {
+		if domain == "" || len(domain) > 128 || strings.ContainsAny(domain, " /\\\t\r\n") {
+			return nil, errors.New("invalid MasterDNS domain")
+		}
+	}
+	cfg := config.DefaultServerConfig()
+	cfg.Domain = append([]string(nil), domains...)
+	cfg.DataEncryptionMethod = 5
+	cfg.MinVPNLabelLength = 1
+	cfg.MaxAllowedClientActiveSessions = 8
+	cfg.MaxAllowedClientActiveStreams = 128
+	if in.MaxActiveSessions > 0 {
+		cfg.MaxAllowedClientActiveSessions = in.MaxActiveSessions
+	}
+	if in.MaxStreamsPerSession > 0 {
+		cfg.MaxAllowedClientActiveStreams = in.MaxStreamsPerSession
+	}
+	cfg.DeferredSessionWorkers, cfg.DeferredSessionQueueLimit = 2, 32
+	cfg.DNSCacheMaxRecords, cfg.RecentlyClosedStreamCap = 16, 128
+	cfg.ARQWindowSize = 256
+	cfg.SessionCleanupIntervalSecs = 5
+	codec, err := security.NewCodec(5, in.Key)
+	if err != nil {
+		return nil, err
+	}
+	ctx, cancel := context.WithCancel(parent)
+	s := New(cfg, logger.NewDiscard("MasterDNS account", "ERROR"), codec)
+	// Keep connection attempts independent; a slow host must not block all streams.
+	s.deferredConnectSession = newDeferredSessionProcessor(4, 16, s.log)
+	s.embeddedDialContext = func(caller context.Context, network, address string) (net.Conn, error) {
+		if ctx.Err() != nil || !in.Allowed() {
+			return nil, net.ErrClosed
+		}
+		if caller == nil {
+			caller = context.Background()
+		}
+		dialCtx, stopDial := context.WithTimeout(caller, 15*time.Second)
+		defer stopDial()
+		stop := context.AfterFunc(ctx, stopDial)
+		defer stop()
+		return in.DialContext(dialCtx, network, address)
+	}
+	s.resolveDNSQueryFn = func(raw []byte) ([]byte, error) {
+		if ctx.Err() != nil || !in.Allowed() {
+			return nil, net.ErrClosed
+		}
+		lookupCtx, stop := context.WithTimeout(ctx, 4*time.Second)
+		defer stop()
+		return in.ExchangeDNS(lookupCtx, raw)
+	}
+	e := &Embedded{s: s, ctx: ctx, cancel: cancel, allowed: in.Allowed}
+	s.deferredDNSSession.Start(ctx)
+	s.deferredConnectSession.Start(ctx)
+	e.wg.Add(1)
+	go func() { defer e.wg.Done(); s.sessionCleanupLoop(ctx) }()
+	return e, nil
+}
+
+func (e *Embedded) HandleDNS(query []byte) []byte {
+	e.mu.RLock()
+	defer e.mu.RUnlock()
+	if e.ctx.Err() != nil || len(query) > 65535 || !e.allowed() {
+		return nil
+	}
+	return e.s.safeHandlePacket(query)
+}
+
+// TCP framing belongs to the caller. MasterDNS retains its DNS response budget.
+func (e *Embedded) HandleDNSTCP(query []byte) []byte { return e.HandleDNS(query) }
+
+func (e *Embedded) SessionCount() int {
+	e.s.sessions.mu.RLock()
+	defer e.s.sessions.mu.RUnlock()
+	return int(e.s.sessions.activeCount)
+}
+
+func (e *Embedded) Close() error {
+	e.once.Do(func() {
+		e.cancel()
+		e.mu.Lock()
+		defer e.mu.Unlock()
+		e.s.deferredDNSSession.wg.Wait()
+		e.s.deferredConnectSession.wg.Wait()
+		e.wg.Wait()
+		for id := 1; id <= maxServerSessionID; id++ {
+			if record, ok := e.s.sessions.Close(uint8(id), time.Now(), 0); ok {
+				e.s.cleanupClosedSession(uint8(id), record)
+			}
+		}
+	})
+	return nil
+}
