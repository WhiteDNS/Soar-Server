new file mode 100644
index 0000000..f23b525
--- /dev/null
+++ b/probe/http.go
@@ -0,0 +1,275 @@
+// Package probe verifies an actual authenticated MasterDNS tunnel and HTTPS
+// egress. Credentials stay in memory or private temporary files, never argv.
+package probe
+
+import (
+	"context"
+	"crypto/tls"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"net/http/httptrace"
+	"net/url"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"syscall"
+	"time"
+
+	"golang.org/x/net/proxy"
+	"masterdnsvpn-go/internal/client"
+	"masterdnsvpn-go/internal/config"
+)
+
+type Config struct {
+	Domain    string      `json:"domain"`
+	Key       string      `json:"key"`
+	Resolvers []string    `json:"-"`
+	Transport string      `json:"-"`
+	URL       string      `json:"-"`
+	TLSConfig *tls.Config `json:"-"`
+}
+
+// Result preserves the furthest observed stage, including when a later HTTPS
+// operation fails. ErrorClass is bounded and never includes traffic metadata.
+type Result struct {
+	OK         bool
+	Stage      string
+	Handshake  bool
+	HTTPStatus int
+	ErrorClass string
+}
+
+type progress struct {
+	mu        sync.Mutex
+	stage     string
+	connected bool
+}
+
+func (p *progress) mark(stage string) {
+	p.mu.Lock()
+	p.stage = stage
+	p.mu.Unlock()
+}
+
+func (p *progress) connect() {
+	p.mu.Lock()
+	p.connected, p.stage = true, "socks"
+	p.mu.Unlock()
+}
+
+func (p *progress) snapshot() (string, bool) {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	return p.stage, p.connected
+}
+
+type runtimeStoppedError struct{ class string }
+
+func (e runtimeStoppedError) Error() string { return "MasterDNS client stopped before HTTPS completed" }
+
+func classifyError(err error) string {
+	if err == nil {
+		return ""
+	}
+	var stopped runtimeStoppedError
+	if errors.As(err, &stopped) {
+		return stopped.class
+	}
+	if errors.Is(err, context.DeadlineExceeded) {
+		return "deadline_exceeded"
+	}
+	if errors.Is(err, context.Canceled) {
+		return "cancelled"
+	}
+	if errors.Is(err, syscall.EADDRINUSE) {
+		return "address_in_use"
+	}
+	if errors.Is(err, syscall.ECONNREFUSED) {
+		return "connection_refused"
+	}
+	if errors.Is(err, syscall.ECONNRESET) {
+		return "connection_reset"
+	}
+	if errors.Is(err, io.EOF) || errors.Is(err, io.ErrUnexpectedEOF) {
+		return "connection_closed"
+	}
+	var certificate *tls.CertificateVerificationError
+	if errors.As(err, &certificate) {
+		return "tls_certificate_error"
+	}
+	var networkError net.Error
+	if errors.As(err, &networkError) && networkError.Timeout() {
+		return "network_timeout"
+	}
+	return "operation_failed"
+}
+
+func CheckHTTP(parent context.Context, in Config) (int, error) {
+	result, err := CheckHTTPDetailed(parent, in)
+	return result.HTTPStatus, err
+}
+
+// CheckHTTPDetailed runs the same native-client check as CheckHTTP and retains
+// authenticated connection state on a subsequent TLS or HTTP failure.
+func CheckHTTPDetailed(parent context.Context, in Config) (result Result, returnedErr error) {
+	result.Stage = "configuration"
+	fail := func(class, message string) (Result, error) {
+		result.ErrorClass = class
+		return result, errors.New(message)
+	}
+	u, err := url.Parse(in.URL)
+	if err != nil || u.Scheme != "https" || u.Hostname() == "" || u.User != nil || u.Fragment != "" {
+		return fail("invalid_configuration", "probe requires an HTTPS destination")
+	}
+	if parent == nil || len(in.Key) < 32 || len(in.Domain) < 3 || len(in.Resolvers) == 0 {
+		return fail("invalid_configuration", "missing MasterDNS probe credentials or resolvers")
+	}
+	if in.Transport != "udp" && in.Transport != "auto" {
+		return fail("invalid_configuration", "invalid MasterDNS DNS transport")
+	}
+	work, err := os.MkdirTemp("", "whitedns-masterdns-check-")
+	if err != nil {
+		return fail("local_setup_failed", "MasterDNS probe temporary setup failed")
+	}
+	defer os.RemoveAll(work)
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		return fail("local_setup_failed", "MasterDNS probe listener setup failed")
+	}
+	address := listener.Addr().String()
+	port := listener.Addr().(*net.TCPAddr).Port
+	listener.Close()
+	text := fmt.Sprintf(`PROTOCOL_TYPE = "SOCKS5"
+LISTEN_IP = "127.0.0.1"
+LISTEN_PORT = %d
+SOCKS5_AUTH = false
+LOCAL_DNS_ENABLED = false
+DOMAINS = [%q]
+ENCRYPTION_KEY = %q
+DATA_ENCRYPTION_METHOD = 5
+MIN_UPLOAD_MTU = 80
+MAX_UPLOAD_MTU = 142
+MIN_DOWNLOAD_MTU = 16
+MAX_DOWNLOAD_MTU = 1500
+MTU_TEST_RETRIES = 1
+MTU_TEST_TIMEOUT = 1.0
+MTU_TEST_PARALLELISM = 1
+PACKET_DUPLICATION_COUNT = 0
+SETUP_PACKET_DUPLICATION_COUNT = 1
+RECHECK_INACTIVE_SERVERS_ENABLED = false
+AUTO_DISABLE_TIMEOUT_SERVERS = false
+SAVE_MTU_SERVERS_TO_FILE = false
+LOG_LEVEL = "ERROR"
+`, port, in.Domain, in.Key)
+	configPath, resolverPath := filepath.Join(work, "client.toml"), filepath.Join(work, "resolvers.txt")
+	if err = os.WriteFile(configPath, []byte(text), 0600); err != nil {
+		return fail("local_setup_failed", "MasterDNS probe configuration could not be written")
+	}
+	if err = os.WriteFile(resolverPath, []byte(strings.Join(in.Resolvers, "\n")+"\n"), 0600); err != nil {
+		return fail("local_setup_failed", "MasterDNS probe resolvers could not be written")
+	}
+	app, err := client.BootstrapSilent(configPath, config.ClientConfigOverrides{ResolversFilePath: &resolverPath})
+	if err != nil {
+		return fail("invalid_configuration", "MasterDNS probe configuration failed")
+	}
+	ctx, cancel := context.WithCancel(parent)
+	done := make(chan struct{})
+	var runtimeErr error
+	go func() {
+		defer close(done)
+		runtimeErr = app.Run(ctx)
+	}()
+	state := &progress{stage: "startup"}
+	defer func() {
+		result.Stage, result.Handshake = state.snapshot()
+		if result.OK {
+			result.Stage = "complete"
+		}
+	}()
+	defer func() {
+		cancel()
+		select {
+		case <-done:
+		case <-time.After(10 * time.Second):
+			if returnedErr == nil {
+				result.OK, result.ErrorClass = false, "cleanup_timeout"
+				state.mark("cleanup")
+				returnedErr = errors.New("MasterDNS probe shutdown timed out")
+			}
+		}
+	}()
+	dialer, err := proxy.SOCKS5("tcp", address, nil, &net.Dialer{Timeout: 5 * time.Second})
+	if err != nil {
+		return fail("local_setup_failed", "MasterDNS probe proxy setup failed")
+	}
+	contextDialer := dialer.(proxy.ContextDialer)
+	transport := &http.Transport{TLSClientConfig: in.TLSConfig, DisableKeepAlives: true, DialContext: func(ctx context.Context, network, target string) (net.Conn, error) {
+		for {
+			conn, err := contextDialer.DialContext(ctx, network, target)
+			if err == nil {
+				state.connect()
+				return conn, nil
+			}
+			// The legacy client may open SOCKS before its tunnel session is ready.
+			select {
+			case <-ctx.Done():
+				return nil, ctx.Err()
+			case <-done:
+				if ctx.Err() != nil {
+					return nil, ctx.Err()
+				}
+				class := classifyError(runtimeErr)
+				if class == "" {
+					class = "client_stopped"
+				}
+				return nil, runtimeStoppedError{class: class}
+			case <-time.After(50 * time.Millisecond):
+			}
+		}
+	}}
+	defer transport.CloseIdleConnections()
+	httpClient := &http.Client{Transport: transport, CheckRedirect: func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }}
+	trace := &httptrace.ClientTrace{
+		TLSHandshakeStart: func() { state.mark("tls") },
+		TLSHandshakeDone: func(_ tls.ConnectionState, err error) {
+			if err == nil {
+				state.mark("http")
+			}
+		},
+		WroteRequest: func(info httptrace.WroteRequestInfo) {
+			if info.Err == nil {
+				state.mark("http")
+			}
+		},
+	}
+	req, err := http.NewRequestWithContext(httptrace.WithClientTrace(ctx, trace), "GET", in.URL, nil)
+	if err != nil {
+		return fail("invalid_configuration", "MasterDNS probe request configuration failed")
+	}
+	response, err := httpClient.Do(req)
+	if err != nil {
+		if ctx.Err() != nil {
+			err = ctx.Err()
+		}
+		return fail(classifyError(err), "MasterDNS tunnel HTTPS test failed; check DNS transport and outbound access")
+	}
+	defer response.Body.Close()
+	result.HTTPStatus = response.StatusCode
+	state.mark("body")
+	if _, err = io.Copy(io.Discard, io.LimitReader(response.Body, 64<<10)); err != nil {
+		if ctx.Err() != nil {
+			err = ctx.Err()
+		}
+		return fail(classifyError(err), "MasterDNS HTTPS response incomplete")
+	}
+	if response.StatusCode < 200 || response.StatusCode >= 400 {
+		state.mark("http")
+		return fail("http_status", "MasterDNS HTTPS destination returned an unsuccessful status")
+	}
+	result.OK = true
+	return result, nil
+}
