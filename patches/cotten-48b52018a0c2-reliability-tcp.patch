diff --git a/internal/client/transport_timeout_recovery_test.go b/internal/client/transport_timeout_recovery_test.go
new file mode 100644
index 0000000..ff87f75
--- /dev/null
+++ b/internal/client/transport_timeout_recovery_test.go
@@ -0,0 +1,228 @@
+package client
+
+import (
+	"bytes"
+	"encoding/binary"
+	"errors"
+	"net"
+	"testing"
+	"time"
+)
+
+// A timeout can consume a DNS frame's length and part of its body. The next
+// MTU probe must either finish/discard that frame or reconnect; treating its
+// remaining body bytes as a fresh length poisons all subsequent probes.
+func TestTCPQueryTransportRecoversAfterPartialResponseTimeout(t *testing.T) {
+	for _, tc := range []struct {
+		name  string
+		bytes int
+	}{{"partial_length", 1}, {"partial_body", 5}} {
+		t.Run(tc.name, func(t *testing.T) {
+			testTCPQueryTransportRecoversAfterPartialResponseTimeout(t, tc.bytes)
+		})
+	}
+}
+
+func testTCPQueryTransportRecoversAfterPartialResponseTimeout(t *testing.T, partialBytes int) {
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer listener.Close()
+	query1, query2 := make([]byte, 12), make([]byte, 12)
+	binary.BigEndian.PutUint16(query1, 0x1111)
+	binary.BigEndian.PutUint16(query2, 0x2222)
+	response1, response2 := make([]byte, 24), make([]byte, 24)
+	copy(response1, query1)
+	copy(response2, query2)
+	response1[2], response1[3], response2[2], response2[3] = 0x81, 0x80, 0x81, 0x80
+	serverDone := make(chan error, 1)
+	go func() {
+		conn, err := listener.Accept()
+		if err != nil {
+			serverDone <- err
+			return
+		}
+		defer conn.Close()
+		_ = conn.SetDeadline(time.Now().Add(2 * time.Second))
+		if _, err = readTCPDNSFramed(conn); err != nil {
+			serverDone <- err
+			return
+		}
+		partial := binary.BigEndian.AppendUint16(nil, uint16(len(response1)))
+		partial = append(partial, response1...)
+		partial = partial[:partialBytes]
+		if _, err = conn.Write(partial); err != nil {
+			serverDone <- err
+			return
+		}
+		// Read the retry before completing the first reply. A repaired transport
+		// may instead close the damaged connection and dial a fresh one.
+		if _, err = readTCPDNSFramed(conn); err != nil {
+			_ = conn.Close()
+			conn, err = listener.Accept()
+			if err != nil {
+				serverDone <- err
+				return
+			}
+			defer conn.Close()
+			_ = conn.SetDeadline(time.Now().Add(2 * time.Second))
+			if _, err = readTCPDNSFramed(conn); err != nil {
+				serverDone <- err
+				return
+			}
+			serverDone <- writeTCPDNSFramed(conn, response2)
+			return
+		}
+		remaining := binary.BigEndian.AppendUint16(nil, uint16(len(response1)))
+		remaining = append(remaining, response1...)
+		remaining = append([]byte(nil), remaining[partialBytes:]...)
+		remaining = binary.BigEndian.AppendUint16(remaining, uint16(len(response2)))
+		remaining = append(remaining, response2...)
+		_, err = conn.Write(remaining)
+		serverDone <- err
+	}()
+	transport, err := newTCPQueryTransport(listener.Addr().String(), time.Second)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer transport.Close()
+	if _, err = transport.exchange(query1, 100*time.Millisecond); err == nil {
+		t.Fatal("expected first partial reply to time out")
+	}
+	response, err := transport.exchange(query2, time.Second)
+	if err != nil || !bytes.Equal(response, response2) {
+		t.Fatalf("valid next query could not recover from previous partial-frame timeout: response=%x err=%v", response, err)
+	}
+	if err = <-serverDone; err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestTCPQueryTransportReconnectSharesExchangeDeadlineAndCloseIsFinal(t *testing.T) {
+	dials := 0
+	var reconnectBudget time.Duration
+	var exchangeDeadline time.Time
+	transport, err := newStreamQueryTransport(func(timeout time.Duration) (net.Conn, error) {
+		dials++
+		conn, peer := net.Pipe()
+		if dials == 1 {
+			_ = peer.Close()
+			return conn, nil
+		}
+		reconnectBudget = timeout
+		// Spend part of this exchange's budget establishing the replacement.
+		time.Sleep(40 * time.Millisecond)
+		go func() {
+			defer peer.Close()
+			_, _ = readTCPDNSFramed(peer)
+			// Keep the socket open without a response. The read deadline must
+			// still be the original exchange deadline, not a fresh budget.
+			_, _ = peer.Read(make([]byte, 1))
+		}()
+		return &tcpQueryDeadlineConn{Conn: conn, deadline: &exchangeDeadline}, nil
+	}, time.Second)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer transport.Close()
+	query := []byte{0x12, 0x34}
+	if _, err = transport.exchange(query, time.Second); err == nil {
+		t.Fatal("expected the closed first connection to fail")
+	}
+	start := time.Now()
+	_, err = transport.exchange(query, 100*time.Millisecond)
+	var netErr net.Error
+	if !errors.As(err, &netErr) || !netErr.Timeout() {
+		t.Fatalf("expected an exchange timeout, got %v", err)
+	}
+	if reconnectBudget <= 0 || reconnectBudget > 100*time.Millisecond {
+		t.Fatalf("reconnect got a separate timeout budget: %s", reconnectBudget)
+	}
+	if budget := exchangeDeadline.Sub(start); budget <= 0 || budget > 110*time.Millisecond {
+		t.Fatalf("dial time was added to the exchange deadline: %s", budget)
+	}
+	if err = transport.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err = transport.exchange(query, time.Second); !errors.Is(err, net.ErrClosed) {
+		t.Fatalf("exchange after Close returned %v", err)
+	}
+	if dials != 2 {
+		t.Fatalf("closed transport redialed: %d dials", dials)
+	}
+}
+
+type tcpQueryDeadlineConn struct {
+	net.Conn
+	deadline *time.Time
+}
+
+func (c *tcpQueryDeadlineConn) SetDeadline(deadline time.Time) error {
+	*c.deadline = deadline
+	return c.Conn.SetDeadline(deadline)
+}
+
+func TestTCPQueryTransportCloseInterruptsExchange(t *testing.T) {
+	for i := 0; i < 16; i++ {
+		conn, peer := net.Pipe()
+		transport := &tcpQueryTransport{conn: conn}
+		queryRead := make(chan struct{})
+		go func() {
+			defer peer.Close()
+			_, _ = readTCPDNSFramed(peer)
+			close(queryRead)
+			_, _ = peer.Read(make([]byte, 1))
+		}()
+		done := make(chan error, 1)
+		go func() {
+			_, err := transport.exchange([]byte{0x12, 0x34}, time.Minute)
+			done <- err
+		}()
+		<-queryRead
+		if err := transport.Close(); err != nil {
+			t.Fatal(err)
+		}
+		select {
+		case err := <-done:
+			if err == nil {
+				t.Fatal("closed exchange succeeded")
+			}
+		case <-time.After(time.Second):
+			t.Fatal("Close failed to interrupt the active exchange")
+		}
+	}
+}
+
+func TestTCPQueryTransportToleratesSevenMismatchedResponseIDs(t *testing.T) {
+	conn, peer := net.Pipe()
+	transport := &tcpQueryTransport{conn: conn}
+	defer transport.Close()
+	serverDone := make(chan error, 1)
+	go func() {
+		defer peer.Close()
+		if _, err := readTCPDNSFramed(peer); err != nil {
+			serverDone <- err
+			return
+		}
+		for i := 0; i < 8; i++ {
+			id := uint16(i)
+			if i == 7 {
+				id = 0x1234
+			}
+			if err := writeTCPDNSFramed(peer, binary.BigEndian.AppendUint16(nil, id)); err != nil {
+				serverDone <- err
+				return
+			}
+		}
+		serverDone <- nil
+	}()
+	query := []byte{0x12, 0x34}
+	response, err := transport.exchange(query, time.Second)
+	if err != nil || !bytes.Equal(response, query) {
+		t.Fatalf("response ID filtering changed: response=%x err=%v", response, err)
+	}
+	if err = <-serverDone; err != nil {
+		t.Fatal(err)
+	}
+}
diff --git a/internal/dnsparser/response_budget.go b/internal/dnsparser/response_budget.go
new file mode 100644
index 0000000..575b7ba
--- /dev/null
+++ b/internal/dnsparser/response_budget.go
@@ -0,0 +1,125 @@
+package dnsparser
+
+import (
+	"encoding/binary"
+	"sort"
+
+	baseCodec "cottendns-go/internal/basecodec"
+	Enums "cottendns-go/internal/enums"
+)
+
+// UDPResponseLimit is the requestor's advertised DNS message size. Without
+// EDNS, or with an advertisement below the DNS minimum, the limit is 512.
+func UDPResponseLimit(question []byte) int {
+	limit := 512
+	if len(question) < dnsHeaderSize {
+		return limit
+	}
+	header := parseHeader(question)
+	_, _, end := extractQuestionSection(question, header)
+	if start, size := findOPTRecordRange(question, header, end); size >= 5 && question[start] == 0 {
+		limit = max(limit, int(binary.BigEndian.Uint16(question[start+3:start+5])))
+	}
+	return limit
+}
+
+// BoundUDPResponse keeps the question and OPT, but never a partial tunnel frame,
+// when a control/probe response cannot fit. TC permits a recursive resolver to
+// retry the original question over TCP. Queued data is sized before dequeue.
+func BoundUDPResponse(question, response []byte) []byte {
+	if len(response) <= UDPResponseLimit(question) {
+		return response
+	}
+	if len(question) < dnsHeaderSize {
+		return nil
+	}
+	header := parseHeader(question)
+	questions, count, end := extractQuestionSection(question, header)
+	optStart, optLen := findOPTRecordRange(question, header, end)
+	out := make([]byte, dnsHeaderSize+len(questions)+optLen)
+	copy(out[:2], question[:2])
+	binary.BigEndian.PutUint16(out[2:4], buildResponseFlags(header.Flags, 0)|0x0200)
+	binary.BigEndian.PutUint16(out[4:6], count)
+	binary.BigEndian.PutUint16(out[10:12], uint16(getARCount(optLen)))
+	copy(out[dnsHeaderSize:], questions)
+	if optLen > 0 {
+		copy(out[dnsHeaderSize+len(questions):], question[optStart:optStart+optLen])
+	}
+	if len(out) > UDPResponseLimit(question) {
+		return nil
+	}
+	return out
+}
+
+// ResponseFrameCapacity accounts for the whole answer, including TXT chunk
+// indices, optional base64, DNS records and encryption's opaque-frame framing.
+// The caller subtracts VPN and cipher overhead from the returned frame size.
+func ResponseFrameCapacity(question []byte, domain string, allowA, allowAAAA, baseEncoded, encrypted, tcp bool, reserveQuestionHeadroom ...bool) int {
+	qtype, ok := firstQuestionQType(question)
+	if !ok || len(question) < dnsHeaderSize {
+		return 0
+	}
+	limit := UDPResponseLimit(question)
+	if tcp {
+		limit = 65535
+	}
+	header := parseHeader(question)
+	questions, _, end := extractQuestionSection(question, header)
+	_, optLen := findOPTRecordRange(question, header, end)
+	budget := limit - dnsHeaderSize - len(questions) - optLen
+	if len(reserveQuestionHeadroom) > 0 && reserveQuestionHeadroom[0] {
+		// Session init names are short. Later upload-bearing questions can use
+		// the full 255-byte QNAME plus QTYPE/QCLASS; reserve that echo overhead
+		// when negotiating a session-wide downstream packet size.
+		budget -= max(0, 255+4-len(questions))
+	}
+	if qtype == Enums.DNS_RECORD_TYPE_A || qtype == Enums.DNS_RECORD_TYPE_AAAA ||
+		(qtype != Enums.DNS_RECORD_TYPE_TXT && qtype != Enums.DNS_RECORD_TYPE_NULL && qtype != Enums.DNS_RECORD_TYPE_HTTPS && qtype != Enums.DNS_RECORD_TYPE_SVCB) {
+		// These carriers also have a DNS-name/record-count ceiling. Their
+		// builders already apply the question's UDP budget, including over TCP.
+		capacity := cnameFrameCapacity(domain, budget)
+		if qtype == Enums.DNS_RECORD_TYPE_A && allowA {
+			capacity = max(capacity, aFrameCapacity(budget))
+		}
+		if qtype == Enums.DNS_RECORD_TYPE_AAAA && allowAAAA {
+			capacity = max(capacity, aaaaFrameCapacity(budget))
+		}
+		return max(0, min(capacity, MatchingFrameCapacity(question, domain, allowA, allowAAAA)))
+	}
+	if qtype == Enums.DNS_RECORD_TYPE_NULL {
+		return max(0, min(rrChannelMaxFrame, budget-12))
+	}
+	if qtype == Enums.DNS_RECORD_TYPE_HTTPS || qtype == Enums.DNS_RECORD_TYPE_SVCB {
+		return max(0, min(rrChannelMaxFrame, budget-12-svcbHeaderLen))
+	}
+	return max(0, sort.Search(65536, func(n int) bool {
+		return txtFrameAnswerSize(n, baseEncoded, encrypted) > budget
+	})-1)
+}
+
+func txtFrameAnswerSize(size int, baseEncoded, encrypted bool) int {
+	chunk := maxTXTAnswerPayload
+	if baseEncoded {
+		chunk = maxTXTEncodedChunk
+	}
+	encodedSize := func(n int) int {
+		if baseEncoded {
+			return baseCodec.EncodedRawBase64Len(n)
+		}
+		return n
+	}
+	if !encrypted && size <= chunk {
+		return 12 + 1 + encodedSize(size)
+	}
+	total := 0
+	for first := true; size > 0; first = false {
+		prefix := 1
+		if encrypted || first {
+			prefix = 2
+		}
+		n := min(size, chunk-prefix)
+		total += 12 + 1 + encodedSize(prefix+n)
+		size -= n
+	}
+	return total
+}
