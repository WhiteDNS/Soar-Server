+func TestEmbeddedDialPropagatesCancellationAndRequestedTimeout(t *testing.T) {
+	for _, mode := range []string{"caller_cancel", "caller_deadline", "requested_timeout", "account_close"} {
+		t.Run(mode, func(t *testing.T) {
+			started, released := make(chan struct{}), make(chan struct{})
+			in := embeddedSessionLimitConfig(0)
+			in.DialContext = func(ctx context.Context, _, _ string) (net.Conn, error) {
+				close(started)
+				<-ctx.Done()
+				close(released)
+				return nil, ctx.Err()
+			}
+			e, err := NewEmbedded(context.Background(), in)
+			if err != nil {
+				t.Fatal(err)
+			}
+			t.Cleanup(func() { e.Close() })
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			if mode == "caller_deadline" {
+				var stop context.CancelFunc
+				ctx, stop = context.WithTimeout(ctx, 25*time.Millisecond)
+				defer stop()
+			}
+			done := make(chan error, 1)
+			go func() {
+				var err error
+				if mode == "requested_timeout" {
+					_, err = e.s.dialStreamUpstreamFn("tcp", "8.8.8.8:443", 25*time.Millisecond)
+				} else {
+					_, err = e.s.dialTCPTargetContext(ctx, "8.8.8.8:443")
+				}
+				done <- err
+			}()
+			<-started
+			if mode == "caller_cancel" {
+				cancel()
+			}
+			if mode == "account_close" {
+				e.Close()
+			}
+			select {
+			case err := <-done:
+				if !errors.Is(err, context.Canceled) && !errors.Is(err, context.DeadlineExceeded) {
+					t.Fatalf("dial returned %v", err)
+				}
+			case <-time.After(time.Second):
+				t.Fatal("cancelled dial did not return")
+			}
+			select {
+			case <-released:
+			default:
+				t.Fatal("caller returned but actual outbound dial was still running")
+			}
+		})
+	}
+}
diff --git a/internal/udpserver/response_budget.go b/internal/udpserver/response_budget.go
new file mode 100644
index 0000000..ee4ed5e
--- /dev/null
+++ b/internal/udpserver/response_budget.go
@@ -0,0 +1,97 @@
+package udpserver
+
+import (
+	"time"
+
+	DnsParser "cottendns-go/internal/dnsparser"
+	"cottendns-go/internal/security"
+)
+
+const udpBudgetStallTimeout = 30 * time.Second
+
+func isTCPResponse(tcp []bool) bool { return len(tcp) > 0 && tcp[0] }
+
+func (s *Server) responsePayloadCapacity(question []byte, domain string, mode uint8, codec *security.Codec, tcp bool, reserveQuestionHeadroom ...bool) int {
+	baseEncoded, valid := parseMTUProbeBaseEncoding(mode)
+	if !valid {
+		return 0
+	}
+	encrypted := mode&security.DownstreamEncryptedFlag != 0
+	capacity := DnsParser.ResponseFrameCapacity(question, domain, s.cfg.ARecordDataDelivery, s.cfg.AAAARecordDataDelivery, baseEncoded, encrypted, tcp, reserveQuestionHeadroom...)
+	capacity -= maxVPNFrameHeaderLen
+	if encrypted {
+		if codec == nil {
+			return 0
+		}
+		capacity -= codec.CiphertextOverhead()
+	}
+	return max(0, capacity)
+}
+
+func (s *Server) noteBudgetBlocked(sessionID uint16, capacity int, now time.Time) {
+	if record, ok := s.sessions.Get(sessionID); ok {
+		record.mu.Lock()
+		if record.udpBudgetBlockedSince.IsZero() {
+			record.udpBudgetBlockedSince = now
+			record.udpBudgetBlockedCapacity = capacity
+		}
+		record.mu.Unlock()
+	}
+}
+
+func (s *Server) noteBudgetDelivered(sessionID uint16, size int) {
+	if record, ok := s.sessions.Get(sessionID); ok {
+		record.mu.Lock()
+		if size > record.udpBudgetBlockedCapacity {
+			record.udpBudgetBlockedSince = time.Time{}
+		}
+		record.mu.Unlock()
+	}
+}
+
+// A temporary small carrier retains queued frames for a later larger UDP/TCP
+// poll. If all usable paths shrink, old ARQ sequences cannot be split without
+// changing their meaning to existing clients. Bound that stall with the existing
+// ERROR_DROP recovery signal, then release the old session. The next UDP init
+// negotiates a download MTU that fits its current wire budget.
+func (s *Server) resetBudgetStalledSession(question []byte, name string, view *sessionRuntimeView, capacity int, now time.Time, tcp bool) bool {
+	record, ok := s.sessions.Get(view.ID)
+	if !ok {
+		return false
+	}
+	record.mu.Lock()
+	if tcp || capacity >= record.DownloadMTUBytes {
+		record.udpBudgetBlockedSince = time.Time{}
+		record.mu.Unlock()
+		return false
+	}
+	since := record.udpBudgetBlockedSince
+	record.mu.Unlock()
+	if since.IsZero() || now.Sub(since) < udpBudgetStallTimeout {
+		return false
+	}
+	// Inspect without removing packets. This slow path runs only after a
+	// prolonged stall, so ACKs that already removed the blocked sequence cannot
+	// cause an unnecessary reset of an otherwise healthy session.
+	_, streams := record.activeStreamSnapshot()
+	blocked := false
+	for _, stream := range streams {
+		stream.PopAnyTXPacket(5, func(packet *serverStreamTXPacket) bool {
+			blocked = blocked || len(packet.Payload) > capacity
+			return false
+		})
+		if blocked {
+			break
+		}
+	}
+	if !blocked {
+		record.mu.Lock()
+		record.udpBudgetBlockedSince = time.Time{}
+		record.mu.Unlock()
+		return false
+	}
+	if closed, ok := s.sessions.Close(view.ID, now, s.cfg.ClosedSessionRetention()); ok {
+		s.cleanupClosedSession(view.ID, closed)
+	}
+	return true
+}
diff --git a/internal/udpserver/response_budget_test.go b/internal/udpserver/response_budget_test.go
new file mode 100644
index 0000000..5e523f0
--- /dev/null
+++ b/internal/udpserver/response_budget_test.go
@@ -0,0 +1,196 @@
+package udpserver
+
+import (
+	"bytes"
+	"encoding/binary"
+	"testing"
+	"time"
+
+	DnsParser "cottendns-go/internal/dnsparser"
+	Enums "cottendns-go/internal/enums"
+	"cottendns-go/internal/security"
+	VpnProto "cottendns-go/internal/vpnproto"
+)
+
+func budgetTestQuery(t *testing.T, codec *security.Codec, edns uint16, packet VpnProto.BuildOptions) []byte {
+	t.Helper()
+	encoded, err := VpnProto.BuildEncoded(packet, codec)
+	if err != nil {
+		t.Fatal(err)
+	}
+	name, err := DnsParser.BuildTunnelQuestionName("v.example.com", encoded)
+	if err != nil {
+		t.Fatal(err)
+	}
+	query, err := DnsParser.BuildTXTQuestionPacket(name, Enums.DNS_RECORD_TYPE_TXT, edns)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return query
+}
+
+func budgetTestSession(t *testing.T) (*Server, *sessionRecord, *security.Codec) {
+	t.Helper()
+	s, _ := newDynamicTransportTestServer(t, 5, 5)
+	codec := s.codecs[s.preferredCodec.Load()]
+	payload := []byte{security.DownstreamEncryptedFlag, 0, 0, 100, 16, 0, 1, 2, 3, 4}
+	record, _, err := s.sessions.findOrCreate(payload, 0, 0, 8, false, codec)
+	if err != nil || record == nil {
+		t.Fatal("create session", err)
+	}
+	t.Cleanup(func() {
+		if closed, ok := s.sessions.Close(record.ID, time.Now(), 0); ok {
+			s.cleanupClosedSession(record.ID, closed)
+		}
+	})
+	return s, record, codec
+}
+
+func TestResponseBudgetRetainsQueuedPayloadAcrossMixedUDPAndTCP(t *testing.T) {
+	for _, tcp := range []bool{false, true} {
+		t.Run(map[bool]string{false: "larger_udp", true: "tcp"}[tcp], func(t *testing.T) {
+			s, record, codec := budgetTestSession(t)
+			payload := make([]byte, 2800)
+			for i := range payload {
+				payload[i] = byte(i*73 + i/251)
+			}
+			if !s.queueMainSessionPacket(record.ID, VpnProto.Packet{PacketType: Enums.PACKET_DNS_QUERY_RES, SequenceNum: 7, TotalFragments: 1, Payload: payload}) {
+				t.Fatal("queue")
+			}
+			poll := func(edns uint16, tcp bool) VpnProto.Packet {
+				t.Helper()
+				query := budgetTestQuery(t, codec, edns, VpnProto.BuildOptions{SessionID: record.ID, SessionCookie: record.Cookie, PacketType: Enums.PACKET_PING})
+				var response []byte
+				if tcp {
+					response = s.safeHandlePacketTCP(query)
+				} else {
+					response = s.safeHandlePacket(query)
+					if len(response) > max(512, int(edns)) {
+						t.Fatal("UDP budget exceeded", len(response))
+					}
+				}
+				packet, err := DnsParser.ExtractEncryptedVPNResponseMatching(response, false, []string{"v.example.com"}, codec)
+				if err != nil {
+					t.Fatal(err)
+				}
+				return packet
+			}
+			for _, size := range []uint16{512, 1232, 512} {
+				if packet := poll(size, false); packet.PacketType != Enums.PACKET_PONG {
+					t.Fatal("oversized payload was removed", packet.PacketType)
+				}
+			}
+			if packet := poll(map[bool]uint16{false: 4096, true: 512}[tcp], tcp); packet.PacketType != Enums.PACKET_DNS_QUERY_RES || !bytes.Equal(packet.Payload, payload) {
+				t.Fatal("retained payload lost or changed")
+			}
+			record.mu.RLock()
+			stillBlocked := !record.udpBudgetBlockedSince.IsZero()
+			record.mu.RUnlock()
+			if stillBlocked {
+				t.Fatal("healthy larger path did not clear stall recovery timer")
+			}
+		})
+	}
+}
+
+func TestResponseBudgetSessionNegotiationPreservesTCP(t *testing.T) {
+	for _, tcp := range []bool{false, true} {
+		t.Run(map[bool]string{false: "udp", true: "tcp"}[tcp], func(t *testing.T) {
+			s, _ := newDynamicTransportTestServer(t, 5, 5)
+			codec, _ := security.NewCodec(5, "transport-matrix-shared-key")
+			init := []byte{security.DownstreamEncryptedFlag, 0, 0, 100, 16, 0, 9, 8, 7, 6}
+			query := budgetTestQuery(t, codec, 512, VpnProto.BuildOptions{PacketType: Enums.PACKET_SESSION_INIT, Payload: init})
+			var response []byte
+			if tcp {
+				response = s.safeHandlePacketTCP(query)
+			} else {
+				response = s.safeHandlePacket(query)
+			}
+			packet, err := DnsParser.ExtractEncryptedVPNResponseMatching(response, false, []string{"v.example.com"}, codec)
+			if err != nil || packet.PacketType != Enums.PACKET_SESSION_ACCEPT {
+				t.Fatal("handshake", err)
+			}
+			id := binary.BigEndian.Uint16(packet.Payload[:2])
+			record, ok := s.sessions.Get(id)
+			if !ok {
+				t.Fatal("session absent")
+			}
+			t.Cleanup(func() {
+				if closed, ok := s.sessions.Close(id, time.Now(), 0); ok {
+					s.cleanupClosedSession(id, closed)
+				}
+			})
+			if tcp && record.DownloadMTUBytes != 4096 {
+				t.Fatal("TCP session incorrectly received UDP clamp", record.DownloadMTUBytes)
+			}
+			if !tcp && (record.DownloadMTUBytes <= 0 || record.DownloadMTUBytes >= 512) {
+				t.Fatal("UDP session did not negotiate safe MTU", record.DownloadMTUBytes)
+			}
+			if s.clientPolicy.MaxDownloadMTU != 0 || s.cfg.MaxAllowedClientDownloadMTU != 0 {
+				t.Fatal("negotiation changed server settings")
+			}
+		})
+	}
+}
+
+func TestResponseBudgetPersistentShrinkExplicitlyResetsAndRenegotiates(t *testing.T) {
+	s, record, codec := budgetTestSession(t)
+	if !s.queueMainSessionPacket(record.ID, VpnProto.Packet{PacketType: Enums.PACKET_DNS_QUERY_RES, SequenceNum: 7, TotalFragments: 1, Payload: make([]byte, 2800)}) {
+		t.Fatal("queue")
+	}
+	poll := func() VpnProto.Packet {
+		query := budgetTestQuery(t, codec, 512, VpnProto.BuildOptions{SessionID: record.ID, SessionCookie: record.Cookie, PacketType: Enums.PACKET_PING})
+		packet, err := DnsParser.ExtractEncryptedVPNResponseMatching(s.safeHandlePacket(query), false, []string{"v.example.com"}, codec)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return packet
+	}
+	if poll().PacketType != Enums.PACKET_PONG {
+		t.Fatal("first small poll must retain")
+	}
+	record.mu.Lock()
+	record.udpBudgetBlockedSince = time.Now().Add(-udpBudgetStallTimeout - time.Second)
+	record.mu.Unlock()
+	if poll().PacketType != Enums.PACKET_ERROR_DROP {
+		t.Fatal("persistent small path did not request explicit recovery")
+	}
+	if s.sessions.HasActive(record.ID) {
+		t.Fatal("unusable session retained after reset")
+	}
+	init := []byte{security.DownstreamEncryptedFlag, 0, 0, 100, 16, 0, 9, 8, 7, 6}
+	query := budgetTestQuery(t, codec, 512, VpnProto.BuildOptions{PacketType: Enums.PACKET_SESSION_INIT, Payload: init})
+	accepted, err := DnsParser.ExtractEncryptedVPNResponseMatching(s.safeHandlePacket(query), false, []string{"v.example.com"}, codec)
+	if err != nil || accepted.PacketType != Enums.PACKET_SESSION_ACCEPT {
+		t.Fatal("recovery handshake", err)
+	}
+	policy, ok := VpnProto.DecodeSessionAcceptPolicy(accepted.Payload, false)
+	if !ok || policy.MaxDownloadMTU <= 0 || policy.MaxDownloadMTU >= 512 {
+		t.Fatal("recovery lacks usable MTU ceiling", policy.MaxDownloadMTU)
+	}
+	id := binary.BigEndian.Uint16(accepted.Payload[:2])
+	next, ok := s.sessions.Get(id)
+	if !ok || next.DownloadMTUBytes != policy.MaxDownloadMTU {
+		t.Fatal("server and existing client policy disagree")
+	}
+	t.Cleanup(func() {
+		if closed, ok := s.sessions.Close(id, time.Now(), 0); ok {
+			s.cleanupClosedSession(id, closed)
+		}
+	})
+}
+
+func TestResponseBudgetMTUProbeUDPAndTCP(t *testing.T) {
+	s, _ := newDynamicTransportTestServer(t, 5, 5)
+	codec, _ := security.NewCodec(5, "transport-matrix-shared-key")
+	payload := []byte{security.DownstreamEncryptedFlag, 1, 2, 3, 4, 5, 220} // 1500 bytes
+	query := budgetTestQuery(t, codec, 512, VpnProto.BuildOptions{SessionID: 255, PacketType: Enums.PACKET_MTU_DOWN_REQ, Payload: payload})
+	response := s.safeHandlePacket(query)
+	if len(response) > 512 || len(response) < 12 || response[2]&2 == 0 {
+		t.Fatal("UDP MTU probe did not honor limit")
+	}
+	packet, err := DnsParser.ExtractEncryptedVPNResponseMatching(s.safeHandlePacketTCP(query), false, []string{"v.example.com"}, codec)
+	if err != nil || packet.PacketType != Enums.PACKET_MTU_DOWN_RES || len(packet.Payload) != 1500 {
+		t.Fatal("TCP retry lost full probe", err, len(packet.Payload))
+	}
+}
diff --git a/probe/http_test.go b/probe/http_test.go
new file mode 100644
index 0000000..001a2ef
--- /dev/null
+++ b/probe/http_test.go
@@ -0,0 +1,194 @@
+package probe
+
+import (
+	"context"
+	"crypto/tls"
+	"crypto/x509"
+	"encoding/binary"
+	"errors"
+	"io"
+	"log"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	cottenserver "cottendns-go/server"
+)
+
+const testKey = "test-only-probe-account-key-0000000001"
+
+// Exercise the real encrypted client, framed TCP DNS transport, SOCKS proxy and
+// embedded server. Only outbound origin dialing is redirected to a local test.
+func testTunnel(t *testing.T, origin string) Config {
+	t.Helper()
+	ctx, cancel := context.WithCancel(context.Background())
+	engine, err := cottenserver.New(ctx, cottenserver.Config{
+		Domain: "tunnel.example", Key: testKey,
+		Allowed: func() bool { return true },
+		DialContext: func(ctx context.Context, _, _ string) (net.Conn, error) {
+			return (&net.Dialer{}).DialContext(ctx, "tcp", origin)
+		},
+		ExchangeDNS: func(context.Context, []byte) ([]byte, error) { return nil, errors.New("unused DNS egress") },
+	})
+	if err != nil {
+		cancel()
+		t.Fatal(err)
+	}
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		cancel()
+		engine.Close()
+		t.Fatal(err)
+	}
+	var mu sync.Mutex
+	connections := make(map[net.Conn]struct{})
+	var workers sync.WaitGroup
+	workers.Add(1)
+	go func() {
+		defer workers.Done()
+		for {
+			conn, err := listener.Accept()
+			if err != nil {
+				return
+			}
+			mu.Lock()
+			if ctx.Err() != nil {
+				mu.Unlock()
+				conn.Close()
+				return
+			}
+			connections[conn] = struct{}{}
+			mu.Unlock()
+			workers.Add(1)
+			go func() {
+				defer workers.Done()
+				defer func() { conn.Close(); mu.Lock(); delete(connections, conn); mu.Unlock() }()
+				for {
+					var size [2]byte
+					if _, err := io.ReadFull(conn, size[:]); err != nil {
+						return
+					}
+					packet := make([]byte, int(binary.BigEndian.Uint16(size[:])))
+					if _, err := io.ReadFull(conn, packet); err != nil {
+						return
+					}
+					response := engine.HandleDNSTCP(packet)
+					if len(response) == 0 {
+						return
+					}
+					frame := binary.BigEndian.AppendUint16(nil, uint16(len(response)))
+					if _, err := conn.Write(append(frame, response...)); err != nil {
+						return
+					}
+				}
+			}()
+		}
+	}()
+	t.Cleanup(func() {
+		cancel()
+		listener.Close()
+		mu.Lock()
+		for conn := range connections {
+			conn.Close()
+		}
+		mu.Unlock()
+		workers.Wait()
+		engine.Close()
+	})
+	return Config{Domain: "tunnel.example", Key: testKey, Resolvers: []string{listener.Addr().String()}, Transport: "tcp", URL: "https://example.com/"}
+}
+
+func TestDetailedStartupTimeoutDoesNotClaimHandshake(t *testing.T) {
+	work := t.TempDir()
+	t.Setenv("TMPDIR", work)
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	listener.Close()
+	ctx, cancel := context.WithTimeout(context.Background(), 150*time.Millisecond)
+	defer cancel()
+	r, err := CheckHTTPDetailed(ctx, Config{Domain: "tunnel.example", Key: testKey, Resolvers: []string{listener.Addr().String()}, Transport: "tcp", URL: "https://example.com/"})
+	if err == nil || r.OK || r.Handshake || r.Stage != "startup" || r.ErrorClass != "deadline_exceeded" {
+		t.Fatalf("startup failure misreported: %+v, %v", r, err)
+	}
+	if strings.Contains(err.Error(), testKey) || strings.Contains(err.Error(), "tunnel.example") || strings.Contains(err.Error(), listener.Addr().String()) {
+		t.Fatal("error exposed credentials or traffic metadata")
+	}
+	if entries, err := os.ReadDir(work); err != nil || len(entries) != 0 {
+		t.Fatalf("private probe configuration was retained: %d entries, %v", len(entries), err)
+	}
+}
+
+func TestDetailedSuccessfulHTTPS(t *testing.T) {
+	origin := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) { io.WriteString(w, "complete test body") }))
+	defer origin.Close()
+	in := testTunnel(t, origin.Listener.Addr().String())
+	roots := x509.NewCertPool()
+	roots.AddCert(origin.Certificate())
+	in.TLSConfig = &tls.Config{RootCAs: roots}
+	ctx, cancel := context.WithTimeout(context.Background(), 8*time.Second)
+	defer cancel()
+	r, err := CheckHTTPDetailed(ctx, in)
+	if err != nil || !r.OK || !r.Handshake || r.Stage != "complete" || r.HTTPStatus != http.StatusOK || r.ErrorClass != "" {
+		t.Fatalf("successful check misreported: %+v, %v", r, err)
+	}
+}
+
+func TestDetailedTLSFailureRetainsAuthenticatedHandshake(t *testing.T) {
+	origin := httptest.NewUnstartedServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) { io.WriteString(w, "ok") }))
+	origin.Config.ErrorLog = log.New(io.Discard, "", 0)
+	origin.StartTLS()
+	defer origin.Close()
+	in := testTunnel(t, origin.Listener.Addr().String())
+	ctx, cancel := context.WithTimeout(context.Background(), 8*time.Second)
+	defer cancel()
+	r, err := CheckHTTPDetailed(ctx, in)
+	if err == nil || r.OK || !r.Handshake || r.Stage != "tls" || r.ErrorClass != "tls_certificate_error" {
+		t.Fatalf("authenticated TLS failure misreported: %+v, %v", r, err)
+	}
+}
+
+func TestDetailedHTTPTimeoutRetainsAuthenticatedHandshake(t *testing.T) {
+	started := make(chan struct{})
+	origin := httptest.NewTLSServer(http.HandlerFunc(func(_ http.ResponseWriter, r *http.Request) {
+		close(started)
+		<-r.Context().Done()
+	}))
+	defer origin.Close()
+	in := testTunnel(t, origin.Listener.Addr().String())
+	roots := x509.NewCertPool()
+	roots.AddCert(origin.Certificate())
+	in.TLSConfig = &tls.Config{RootCAs: roots}
+	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+	defer cancel()
+	r, err := CheckHTTPDetailed(ctx, in)
+	select {
+	case <-started:
+	default:
+		t.Fatal("request never reached delayed HTTP origin")
+	}
+	if err == nil || r.OK || !r.Handshake || r.Stage != "http" || r.ErrorClass != "deadline_exceeded" {
+		t.Fatalf("authenticated HTTP timeout misreported: %+v, %v", r, err)
+	}
+}
+
+func TestCheckHTTPCompatibilityWrapper(t *testing.T) {
+	origin := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) { w.WriteHeader(http.StatusServiceUnavailable) }))
+	defer origin.Close()
+	in := testTunnel(t, origin.Listener.Addr().String())
+	roots := x509.NewCertPool()
+	roots.AddCert(origin.Certificate())
+	in.TLSConfig = &tls.Config{RootCAs: roots}
+	ctx, cancel := context.WithTimeout(context.Background(), 8*time.Second)
+	defer cancel()
+	status, err := CheckHTTP(ctx, in)
+	if status != http.StatusServiceUnavailable || err == nil {
+		t.Fatalf("compatibility wrapper lost HTTP status: %d, %v", status, err)
+	}
+}
